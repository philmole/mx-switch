<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.mxswitch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <!-- launchd doesn't expand ~ : replace YOURNAME with your Mac username -->
        <string>/Users/YOURNAME/mx-switch/mx_switch.py</string>
        <string>--target</string>
        <string>1</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/mx-switch.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mx-switch.log</string>
</dict>
</plist>
